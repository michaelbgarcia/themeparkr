Package: themeparkr
Type: Package
Title: Wrapper for the 'ThemeParks.wiki' API
Version: 0.2.0
Authors@R: 
    person("Michael B.", "Garcia", , "michaelbgarcia@gmail.com", role = c("aut", "cre"))
